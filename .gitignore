node_modules
dist
.DS_Store
*.local
card-data/source-recovered
.worktrees

# Card Studio working photos — large binaries, not design decisions.
# Each set's crops.json and team-overrides.json stay TRACKED.
card-art/sets/*/photos

# Fetched stat snapshots (scripts/cardgen/cache.js). Derived, re-fetchable, and
# not a design decision — `node scripts/cardgen/fetchCalibrationData.js` rebuilds
# the whole directory. Kept out of the repo because it is a bulk copy of two
# other people's data (Basketball-Reference season tables, dunksandthrees' EPM
# leaderboard) and this repo is public; the DERIVED outputs in
# card-data/generated/ are committed, so the studio and the game need no network.
card-data/cache

# Safety copies exportCardBack.mjs keeps of the previous back. Never ship them.
public/*.bak
card-art/photo-hunt.html

# Windows shortcuts the studio folder collects
*.lnk

# The Live Series' faces (2026-09-23). One set's faces are ~230 MB, and the
# nightly job (.github/workflows/live-series.yml) re-exports all of them, so
# they are never committed: the job publishes them straight to Pages and
# commits only card-data/generated/cards-live.json and live-status.json. Delete
# a local export before `npm run deploy`, or the deploy overwrites the night's
# faces with stale ones — gh-pages keeps whatever a deploy does not touch.
public/cards/live
public/cards/thumbs/live
